      <void property="scriptJS">
       <string>var _6529=_6529!=undefined?_6529:false;get=function(){var list=document.getElementById(&apos;newlist&apos;);if(list){if(!_6529){list.querySelectorAll(&apos;a&apos;).forEach(function(t){t.attributes[0].value=t.baseURI+t.attributes[0].value;});_6529=true;}
var e=document.createElement(&apos;input&apos;);e.value=list.outerHTML;document.body.appendChild(e);e.select();console.clear();document.execCommand(&quot;copy&quot;);document.body.removeChild(e);console.log(&quot;ĐÃ SAO CHÉP DANH SÁCH CHƯƠNG, DÁN VÀO HTML TRÊN UI MANUAL GET&quot;);console.log(&quot;SAU KHI TẢI THÀNH CÔNG, MỞ FILE ĐÃ TẢI VÀ TIẾP TỤC DÁN SCRIPT ĐỂ SẮP XẾP!&quot;);}else{var l=document.querySelectorAll(&apos;#contents&apos;);var s=function(a,b){return a.getAttribute(&apos;data-id&apos;)-b.getAttribute(&apos;data-id&apos;);};console.clear();console.log(&quot;BẮT ĐẦU SẮP XẾP&quot;);l.forEach(function(c,i){lp=c.querySelectorAll(&apos;p&apos;);var ar=[];lp.forEach(function(p){ar.push(p);});ar.sort(s);c.innerHTML=&quot;&quot;;ar.forEach(function(pa){c.appendChild(pa);})
